rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isStaff() {
      return request.auth != null
        && (
          request.auth.token.staff == true
          || request.auth.token.email == 'phimoves@gmail.com'
        );
    }

    function isOwner() {
      return request.auth != null
        && resource.data.ownerUid == request.auth.uid;
    }

    match /users/{uid} {
      allow read: if request.auth != null
        && (request.auth.uid == uid || isStaff());
      allow create, update: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.role == 'client';
      allow delete: if false;
    }

    match /leads/{leadId} {
      allow create: if request.resource.data.keys().hasAll([
          'name', 'phone', 'from', 'to', 'propertySize', 'service', 'source', 'status'
        ])
        && request.resource.data.status == 'new'
        && request.resource.data.name is string
        && request.resource.data.phone is string
        && request.resource.data.name.size() > 1
        && request.resource.data.phone.size() > 5
        && (!('priority' in request.resource.data)
            || request.resource.data.priority in ['normal', 'urgent'])
        && (!('ownerUid' in request.resource.data)
            || request.resource.data.ownerUid == null
            || (request.auth != null
                && request.resource.data.ownerUid == request.auth.uid));

      // Staff: full access. Clients: read own quotes only.
      allow read: if isStaff() || isOwner();
      allow update, delete: if isStaff();
    }
  }
}
